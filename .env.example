# Anthropic Console(https://console.anthropic.com) → API Keys → Create Key 로 발급.
# 이 파일을 .env 로 복사하고 값을 채운 뒤 서버를 다시 시작할 것.
# .env 는 절대 커밋하지 않는다. 키는 서버 프로세스 밖으로 나가지 않는다.
ANTHROPIC_API_KEY=sk-ant-...

# 배포 (npm run deploy). 둘 다 있어야 돈다.
# 훅은 Render → 서비스 → Settings → Deploy Hook 에서 복사한다.
# **이 URL을 아는 사람은 누구나 배포를 돌릴 수 있다.** 커밋하거나 공유하지 말 것.
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-...?key=...
APP_URL=https://....onrender.com
